<?xml version="1.0" encoding="utf-8"?>
<!--
  Una unidad a revisar en la devolucion. Se responde con UN toque (chips de estado) en vez de abrir un
  desplegable, y se ve la foto de lo que hay que revisar. La nota por pieza esta plegada: casi nunca se
  escribe, y antes era un campo obligatorio ocupando espacio en cada tarjeta.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="?attr/colorOutlineVariant"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/foto"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_imagen"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                tools:src="@drawable/ic_imagen_placeholder" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/nombrePrenda"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    tools:text="Traje Veneciano" />

                <TextView
                    android:id="@+id/unidad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="Unidad 1 de 2  ·  dano $ 40.000" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/grupoEstado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:singleLine="false"
            app:singleSelection="true"
            app:selectionRequired="true" />

        <!-- Solo cuando la pieza no volvio: o se cobra la reposicion, o la renta queda pendiente. -->
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/checkPerdidaCobrada"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cobrar la reposicion"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/avisoPendiente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_aviso_error"
            android:padding="8dp"
            android:text="Sin cobrar la reposicion, la renta queda pendiente hasta que la devuelvan."
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="?attr/colorError"
            android:visibility="gone"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonNota"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:minHeight="0dp"
            android:paddingHorizontal="4dp"
            android:text="Agregar nota" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilDescripcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nota de la revision"
            android:visibility="gone"
            tools:visibility="visible">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editDescripcion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
