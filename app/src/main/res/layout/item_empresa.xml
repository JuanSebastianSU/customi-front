<?xml version="1.0" encoding="utf-8"?>
<!--
  Tarjeta de una tienda del marketplace. Rediseño ideal (2026-07-24): portada + logo, ciudad/barrio,
  pastilla abierto/cerrado y «Ver catálogo». Hoy el backend solo da id+nombre: la portada es un color
  decorativo por tienda (adapta a claro/oscuro), el logo cae en la inicial, y ciudad/estado se MAQUETAN
  y se ocultan cuando no hay dato. El lote de backend tiene qué exponer (identidad de tienda).
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:strokeColor="?attr/colorOutlineVariant"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Portada de la tienda (backend: portadaUrl). Sin imagen, un color decorativo por tienda. -->
        <ImageView
            android:id="@+id/portada"
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            tools:background="?attr/colorSecondaryContainer" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="12dp">

            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp">

                <!-- Logo real (backend: logoUrl). Oculto hasta que llegue; se ve la inicial. -->
                <ImageView
                    android:id="@+id/logo"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_imagen"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/avatar"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_circulo"
                    android:gravity="center"
                    android:textAppearance="?attr/textAppearanceHeadlineSmall"
                    android:textColor="?attr/colorOnPrimaryContainer"
                    tools:text="C" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/nombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    tools:text="Disfraces El Carrusel" />

                <TextView
                    android:id="@+id/ciudad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:visibility="gone"
                    tools:text="Chapinero · 1,2 km"
                    tools:visibility="visible" />
            </LinearLayout>

            <com.google.android.material.chip.Chip
                android:id="@+id/chipEstado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:visibility="gone"
                app:chipMinHeight="24dp"
                app:chipStrokeWidth="0dp"
                app:ensureMinTouchTargetSize="false"
                tools:text="Abierto"
                tools:visibility="visible" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="›"
                android:textAppearance="?attr/textAppearanceTitleLarge"
                android:textColor="?attr/colorPrimary" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
