<?xml version="1.0" encoding="utf-8"?>
<!--
  Una renta de la lista de gestion. Estructura: quien y que (cliente + codigo + articulos) > cuando
  (periodo) > que urge (linea de dias, con el color del estado) > que hacer (accion principal a mano,
  el resto en el menu). Antes habia que leer dos fechas ISO para saber si algo vencia y el menu
  ofrecia las 8 acciones incluso sobre una renta cerrada.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="?attr/colorOutlineVariant"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/foto"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_imagen"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                tools:src="@drawable/ic_imagen_placeholder" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/cliente"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    tools:text="Juan Perez" />

                <!-- Codigo de retiro: es lo que el cliente muestra en el mostrador. -->
                <TextView
                    android:id="@+id/codigo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="R-6A783DAA  ·  2 articulos" />

                <TextView
                    android:id="@+id/periodo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:drawablePadding="6dp"
                    android:gravity="center_vertical"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    app:drawableStartCompat="@drawable/ic_calendario"
                    app:drawableTint="?attr/colorOnSurfaceVariant"
                    tools:text="01 ago → 04 ago  ·  3 dias" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/importe"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="?attr/colorPrimary"
                    tools:text="$ 90.000" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipEstado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="2dp"
                    app:chipMinHeight="24dp"
                    app:chipStrokeWidth="0dp"
                    app:ensureMinTouchTargetSize="false"
                    tools:text="Vencida" />
            </LinearLayout>
        </LinearLayout>

        <!-- Lo que urge, en palabras y del color del estado: se lee sin comparar fechas. -->
        <TextView
            android:id="@+id/urgencia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            tools:text="Vencida hace 2 dias"
            tools:textColor="?attr/colorError" />

        <!-- Que hacer ahora: una sola accion principal segun el estado; el resto vive en el menu. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botonPrincipal"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="44dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                tools:text="Registrar devolucion" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botonAcciones"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minHeight="44dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Mas" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
