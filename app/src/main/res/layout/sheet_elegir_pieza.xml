<?xml version="1.0" encoding="utf-8"?>
<!--
  Seleccion de la prenda de una pieza del disfraz. Se abre desde la lista de piezas y ocupa casi toda
  la pantalla: es el momento en que el cliente COMPARA opciones, y comparar necesita fotos grandes.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="8dp">

    <!-- Titulo: que pieza se esta eligiendo y cuantas opciones hay. -->
    <TextView
        android:id="@+id/titulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="18dp"
        android:textAppearance="?attr/textAppearanceHeadlineSmall"
        tools:text="Botas" />

    <TextView
        android:id="@+id/subtitulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        tools:text="6 opciones · elegi una" />

    <!-- Filtros por faceta (talla, color…): una fila por dimensión, chips con conteo. Se arma en runtime
         desde las facetas de la respuesta; queda oculto si el slot no tiene dimensiones filtrables. -->
    <LinearLayout
        android:id="@+id/contenedorFiltros"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="10dp"
        android:visibility="gone"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/botonLimpiarFiltros"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="4dp"
        android:background="?attr/selectableItemBackground"
        android:padding="4dp"
        android:text="Limpiar filtros"
        android:textAppearance="?attr/textAppearanceLabelLarge"
        android:textColor="?attr/colorPrimary"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- Buscar entre las opciones: con muchas prendas, escribir es mas rapido que desplazar. -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilBuscar"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:hint="Buscar entre las opciones">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editBuscar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/listaOpciones"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:minHeight="320dp"
        android:paddingHorizontal="11dp"
        android:paddingVertical="8dp"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:spanCount="2"
        tools:listitem="@layout/item_opcion_grilla" />

    <!-- Estado vacio: cuando el buscador no encuentra nada. -->
    <TextView
        android:id="@+id/textoVacio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingHorizontal="24dp"
        android:paddingVertical="32dp"
        android:text="Ninguna opcion coincide con lo que buscaste."
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- Confirmar (solo en modo multi-seleccion, ej. elegir varios elementos de una parte). Pinned abajo. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/botonListo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:text="Listo"
        android:visibility="gone"
        tools:visibility="visible" />
</LinearLayout>
