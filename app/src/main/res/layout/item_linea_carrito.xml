<?xml version="1.0" encoding="utf-8"?>
<!--
  Una linea del carrito. Card por linea (consistente con la lista de piezas del armado). Separa el
  PERIODO de renta (dato normal, siempre visible) del AVISO de no-disponible (error, rojo, que bloquea
  el checkout): antes ambos compartian un mismo TextView y se confundian.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="?attr/colorOutlineVariant"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/foto"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_imagen"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                tools:src="@drawable/ic_imagen_placeholder" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/descripcion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    tools:text="Camisa blanca de bucanero  ·  x2" />

                <!-- Talla/color de lo elegido. Oculto hasta que el carrito lo devuelva (gap de backend). -->
                <TextView
                    android:id="@+id/variante"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="?attr/colorPrimary"
                    android:visibility="gone"
                    tools:text="Blanco · M"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/precioUnitario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="$ 15.000 / dia" />

                <!-- Periodo de renta de la propia linea (dato normal). Oculto en venta. -->
                <TextView
                    android:id="@+id/periodo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawablePadding="6dp"
                    android:gravity="center_vertical"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:visibility="gone"
                    app:drawableStartCompat="@drawable/ic_calendario"
                    app:drawableTint="?attr/colorOnSurfaceVariant"
                    tools:text="12 ago → 15 ago · 3 dias"
                    tools:visibility="visible" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end|center_vertical"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/subtotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="?attr/colorPrimary"
                    tools:text="$ 30.000" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/botonQuitar"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="Quitar del carrito"
                    app:icon="@drawable/ic_cerrar"
                    app:iconTint="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
        </LinearLayout>

        <!-- Aviso de no-disponible: el articulo dejo de poder cobrarse (el dueno lo cambio o se agoto).
             Bloquea el checkout hasta quitarlo. Rojo, ancho completo, con su propio espacio. -->
        <TextView
            android:id="@+id/aviso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_aviso_error"
            android:drawablePadding="8dp"
            android:gravity="center_vertical"
            android:padding="8dp"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorError"
            android:visibility="gone"
            app:drawableStartCompat="@drawable/ic_estado_error"
            app:drawableTint="?attr/colorError"
            tools:text="Este disfraz es solo para renta, no se puede comprar"
            tools:visibility="visible" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
