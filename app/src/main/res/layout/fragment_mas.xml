<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface"
        app:title="Mas"
        app:titleTextAppearance="?attr/textAppearanceTitleLarge" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingVertical="8dp">

            <LinearLayout
                android:id="@+id/contenedorSecciones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Sucursal activa (multi-sucursal, Fase B): acota ventas/rentas/caja. Solo si hay más de una. -->
            <!-- Nota que aclara para qué sirve el selector, y qué NO hace (no filtra empleados), para
                 evitar la confusión de usarlo esperando que filtre el personal. Su visibilidad la maneja
                 el fragment junto con el botón (solo con más de una sucursal). -->
            <TextView
                android:id="@+id/notaSucursal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="24dp"
                android:text="Acota lo que ves en Ventas, Rentas y Caja a una sucursal. No filtra la lista de empleados: para eso usa los filtros dentro de «Empleados»."
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botonSucursal"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="6dp"
                app:icon="@drawable/ic_chevron_right"
                android:text="Sucursal activa: Todas"
                android:visibility="gone" />

            <!-- Volver a modo compra (Fase B): la misma persona pasa a operar como cliente. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/botonComprar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="24dp"
                app:icon="@drawable/ic_carrito"
                android:text="Ir a comprar" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botonLogout"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                android:text="Cerrar sesion" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
