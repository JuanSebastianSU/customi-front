<?xml version="1.0" encoding="utf-8"?>
<!--
  Configuracion de la tienda. Antes era una lista de switches y campos sin contexto: nadie sabia que
  prendia cada uno. Ahora va en tarjetas por tema y CADA opcion lleva una linea que explica que hace y
  que pasa si se apaga. Guardar queda fijo abajo. Se conservan TODOS los ids (el fragment no cambia).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorSurface"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:title="Configuracion"
            app:titleTextAppearance="?attr/textAppearanceTitleLarge" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- ===================== MODULOS ===================== -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Que puede hacer tu tienda"
                    android:textAppearance="?attr/textAppearanceTitleSmall" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchConteoStock"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Contar el stock" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Lleva la cuenta de cuantas unidades hay. Si lo apagas, solo manejas disponible / no disponible, sin numeros."
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <View style="@style/DivisorConfig" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchMultas"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Cobrar multas" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Permite cobrar danos y retrasos al devolver. Si lo apagas, ninguna devolucion cobra cargos."
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <View style="@style/DivisorConfig" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchMultiSucursal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Varias sucursales" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Habilita manejar mas de un local, con su propio stock y personal."
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <View style="@style/DivisorConfig" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchPagoLinea"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Pago en linea" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Deja que el cliente pague desde la app. Apagado, se cobra solo en el mostrador."
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <View style="@style/DivisorConfig" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchReembolsos"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Aceptar reembolsos" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Permite que el cliente pida que le devuelvan el dinero. Apagado, la bandeja de reembolsos queda cerrada."
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ===================== COBROS ===================== -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Impuesto y moneda"
                    android:textAppearance="?attr/textAppearanceTitleSmall" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Tasa de impuesto"
                    app:helperText="Como fraccion: 0.19 es 19%. En 0 no se agrega impuesto.">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editImpuesto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="Moneda"
                    app:helperText="Codigo de 3 letras, ej. COP, USD, MXN.">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editMoneda"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapCharacters"
                        android:maxLength="3" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- ===================== RECARGO ===================== -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Recargo por devolver tarde"
                    android:textAppearance="?attr/textAppearanceTitleSmall" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Es lo que la app propone cobrar al registrar una devolucion con retraso. En 0 no se cobra recargo."
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Recargo por dia"
                    app:prefixText="$ ">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editRecargo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilModo"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="Como se aplica"
                    app:helperText="Acumulativa: se multiplica por los dias de retraso. Fija: un solo cargo.">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/dropModo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- ===================== REEMBOLSOS ===================== -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Plazo para pedir reembolso"
                    android:textAppearance="?attr/textAppearanceTitleSmall" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Dias para pedir reembolso"
                    app:helperText="Cuantos dias tras la compra puede pedirlo el cliente. 0 = sin limite.">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editVentana"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Material3.CardView.Filled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="0dp"
            app:cardElevation="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botonGuardar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:text="Guardar" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <com.costumi.app.ui.common.StateView
        android:id="@+id/stateView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
